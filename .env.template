# imauth environment configuration
# Copy this file to `.env` and fill in your own values before running.

# Required: 32-byte base64-encoded AES-256 encryption key.
# Generate a new key with: openssl rand -base64 32
IMAUTH_ENCRYPTION_KEY=

# Optional: gRPC API key for client authentication.
# When set, clients must include `Authorization: Bearer <key>` or `x-api-key: <key>`.
# Generate with: openssl rand -hex 32
# Leave empty to run the server without authentication (not recommended for public endpoints).
IMAUTH_API_KEY=

# External hostname or IP that clients use to reach this server.
# Used to construct noVNC viewer URLs for user-driven login.
# Examples: my-server.example.com, 203.0.113.50
# Default: localhost (only works locally)
IMAUTH_SERVER_HOSTNAME=localhost

# noVNC ports — one per Chrome instance (3 slots by default).
# These must be accessible from the client machine for user-driven login.
# When running multiple imauth instances on one host, assign ports in groups
# (e.g. 6110/6111-6113, 6120/6121-6123) to avoid collisions.
IMAUTH_NOVNC_PORT_0=6101
IMAUTH_NOVNC_PORT_1=6102
IMAUTH_NOVNC_PORT_2=6103

# VNC password for noVNC browser access.
IMAUTH_VNC_PASSWORD=imauth

# gRPC host port (default: 6100)
# When running multiple imauth instances on one host, assign ports in groups
# (e.g. 6110/6111-6113, 6120/6121-6123) to avoid collisions.
IMAUTH_GRPC_HOST_PORT=6100

# Optional: PostgreSQL database URL.
# When unset, falls back to SQLite in data_dir.
# Example: postgres://imauth:imauth@localhost:5432/imauth
# IMAUTH_DATABASE_URL=

# Optional: Prometheus metrics HTTP port (default: 9090).
# Exposes /metrics for scraping. Keep internal-only in production.
# IMAUTH_METRICS_PORT=9090
