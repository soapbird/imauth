FROM selenium/standalone-chromium:131.0

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    curl \
    socat \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/chrome-entrypoint.sh /chrome-entrypoint.sh
RUN chmod +x /chrome-entrypoint.sh

EXPOSE 9222 6080

ENTRYPOINT ["/bin/sh", "/chrome-entrypoint.sh"]
